rules_version = '2';

// Toda la lectura y escritura de Firestore pasa por el Admin SDK
// dentro del servidor Next.js. Ningun cliente debe acceder
// directamente a la base de datos, por lo que se deniega todo
// acceso desde el SDK Web. El Admin SDK ignora estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
